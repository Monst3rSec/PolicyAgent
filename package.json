{
  "name": "policyagent",
  "version": "0.1.0",
  "description": "A git-native framework for policy authoring, explanation, and governance",
  "type": "module",
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "spec/",
    "README.md"
  ],
  "bin": {
    "policyagent": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc && node scripts/make-bin-executable.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "cli": "node dist/index.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "link:dev": "npm link"
  },
  "keywords": [
    "policy",
    "governance",
    "git",
    "llm",
    "compliance",
    "controls",
    "frameworks"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Monst3rSec/PolicyAgent.git"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.7.0"
  }
}
